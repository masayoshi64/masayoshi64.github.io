---
import Layout from "../layouts/Layout.astro";
import Publication from "./Publication.astro";
import { UI, inlineLinks, pagePath, profile, publicationsOf, type Lang } from "../lib/site";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = UI[lang];
const recent = [...publicationsOf("conference"), ...publicationsOf("journal")]
  .sort((a, b) => b.year - a.year)
  .slice(0, 3);
---

<Layout lang={lang} page="home">
  <section class="hero">
    <div class="photo">
      <img src="/profile.jpg" alt={profile.name} width="220" height="220" />
    </div>
    <div>
      <span class="eyebrow">{profile.affiliation[lang]}</span>
      <h1>{profile.name}</h1>
      <p class="subname">{profile.nameJa}</p>
      <p class="lead">{profile.lead[lang]}</p>
      <ul class="tags">
        {profile.interests.map((i) => <li>{i}</li>)}
      </ul>
      <div class="actions">
        <a class="btn primary" href={pagePath("works", lang)}>{t.nav.works} →</a>
        <a class="btn" href={pagePath("profile", lang)}>{t.nav.profile} →</a>
        <div class="social">
          {
            profile.social.map((s) => (
              <a href={s.url} title={s.name} aria-label={s.name} target="_blank" rel="noopener me">
                {s.icon === "scholar" ? (
                  <svg width="22" height="22" viewBox="0 0 24 25" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5.242 13.769L0.5 9.5 12 1l11.5 9-5.242 3.769C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.548 1.748-6.758 4.269zM12 10a7 7 0 1 0 0 14 7 7 0 0 0 0-14z" />
                  </svg>
                ) : (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
                  </svg>
                )}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <h2 class="section-label">{t.highlights}</h2>
  <ul class="cards">
    {
      profile.highlights.map((h) => (
        <li class="card">
          <span class:list={["chip", { award: h.award }]}>
            {h.award && "🏆 "}
            {h.tag}
          </span>
          <p class="prose-link" set:html={inlineLinks(h.text[lang])} />
        </li>
      ))
    }
  </ul>

  <h2 class="section-label">
    <span>{t.recent}</span>
    <a href={pagePath("works", lang)}>{t.seeAll}</a>
  </h2>
  <ul class="pubs">
    {recent.map((pub) => <Publication pub={pub} lang={lang} />)}
  </ul>
</Layout>

<style>
  .hero {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 48px;
    padding: 64px 0 48px;
  }

  .photo {
    position: relative;
    width: 220px;
    height: 220px;
  }

  .photo::before {
    content: "";
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    background: conic-gradient(from 180deg, var(--accent), var(--accent-2), var(--accent));
    opacity: 0.85;
  }

  .photo img {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 5px solid var(--bg);
    border-radius: 50%;
  }

  .eyebrow {
    display: inline-block;
    margin-bottom: 14px;
    padding: 4px 12px;
    font-size: 13px;
    font-weight: 600;
    color: var(--accent);
    background: var(--accent-soft);
    border-radius: 999px;
  }

  h1 {
    font-size: clamp(34px, 6vw, 50px);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    background: linear-gradient(120deg, var(--heading) 30%, var(--accent));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .subname {
    margin-top: 6px;
    color: var(--muted);
  }

  .lead {
    margin-top: 16px;
    font-size: 17px;
  }

  .tags {
    margin-top: 18px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: 26px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 18px;
    font-size: 14px;
    font-weight: 600;
    color: var(--heading);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    box-shadow: var(--shadow);
    transition: transform 0.15s, box-shadow 0.15s, border-color 0.15s;
  }

  .btn:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
    box-shadow: var(--shadow-hover);
  }

  .btn.primary {
    color: #fff;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    border-color: transparent;
  }

  .social {
    display: flex;
    gap: 6px;
    margin-left: 6px;
  }

  .social a {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    color: var(--muted);
    border-radius: 10px;
    transition: color 0.15s, background 0.15s;
  }

  .social a:hover {
    color: var(--accent);
    background: var(--accent-soft);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 14px;
    margin-bottom: 48px;
  }

  .card {
    padding: 18px 20px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    transition: transform 0.15s, box-shadow 0.15s;
  }

  .card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-hover);
  }

  .card p {
    margin-top: 8px;
    font-size: 14px;
    line-height: 1.65;
  }

  @media (max-width: 720px) {
    .hero {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 28px;
      padding-top: 40px;
      text-align: center;
    }

    .photo {
      width: 168px;
      height: 168px;
    }

    .tags,
    .actions {
      justify-content: center;
    }
  }
</style>
