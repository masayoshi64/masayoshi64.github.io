---
import Layout from "../layouts/Layout.astro";
import Publication from "./Publication.astro";
import { UI, inlineLinks, pagePath, profile, publicationsOf, type Lang } from "../lib/site";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = UI[lang];
const recent = [...publicationsOf("conference"), ...publicationsOf("journal")]
  .sort((a, b) => b.year - a.year)
  .slice(0, 3);
---

<Layout lang={lang} page="home">
  <section class="hero">
    <div class="photo">
      <img src="/profile.jpg" alt={profile.name} width="220" height="220" />
    </div>
    <div>
      <span class="eyebrow">{profile.affiliation[lang]}</span>
      <h1>{profile.name}</h1>
      <p class="subname">{profile.nameJa}</p>
      <p class="lead">{profile.lead[lang]}</p>
      <ul class="tags">
        {profile.interests.map((i) => <li>{i}</li>)}
      </ul>
      <div class="actions">
        <a class="btn primary" href={pagePath("works", lang)}>{t.nav.works} →</a>
        <a class="btn" href={pagePath("profile", lang)}>{t.nav.profile} →</a>
        <div class="social">
          {
            profile.social.map((s) => (
              <a href={s.url} title={s.name} aria-label={s.name} target="_blank" rel="noopener me">
                {s.icon === "scholar" ? (
                  <svg width="22" height="22" viewBox="0 0 24 25" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5.242 13.769L0.5 9.5 12 1l11.5 9-5.242 3.769C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.548 1.748-6.758 4.269zM12 10a7 7 0 1 0 0 14 7 7 0 0 0 0-14z" />
                  </svg>
                ) : (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
                  </svg>
                )}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <h2 class="section-label">{t.highlights}</h2>
  <ul class="cards">
    {
      profile.highlights.map((h) => (
        <li class="card">
          <span class:list={["chip", { award: h.award }]}>
            {h.award && "★ "}
            {h.tag}
          </span>
          <p class="prose-link" set:html={inlineLinks(h.text[lang])} />
        </li>
      ))
    }
  </ul>

  <h2 class="section-label">
    <span>{t.recent}</span>
    <a href={pagePath("works", lang)}>{t.seeAll}</a>
  </h2>
  <ul class="pubs">
    {recent.map((pub) => <Publication pub={pub} lang={lang} />)}
  </ul>
</Layout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr 200px;
    grid-template-areas: "text photo";
    align-items: start;
    gap: 56px;
    padding: 72px 0 56px;
    margin-bottom: 48px;
    border-bottom: 2px solid var(--rule);
  }

  .hero > div:not(.photo) {
    grid-area: text;
  }

  .photo {
    grid-area: photo;
    width: 200px;
    height: 250px;
    margin-top: 28px;
  }

  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
  }

  .eyebrow {
    display: inline-block;
    margin-bottom: 14px;
    font-family: var(--mono);
    font-size: 12.5px;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--accent);
  }

  h1 {
    font-size: clamp(40px, 8vw, 64px);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.035em;
    color: var(--heading);
  }

  .subname {
    margin-top: 8px;
    color: var(--muted);
  }

  .lead {
    margin-top: 18px;
    font-size: 19px;
    line-height: 1.7;
  }

  .tags {
    margin-top: 20px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: 28px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 18px;
    font-size: 14px;
    font-weight: 700;
    color: var(--heading);
    border: 1.5px solid var(--rule);
    transition: color 0.15s, background 0.15s, border-color 0.15s;
  }

  .btn.primary {
    color: var(--bg);
    background: var(--heading);
  }

  .btn:hover {
    color: #fff;
    background: var(--accent);
    border-color: var(--accent);
  }

  .social {
    display: flex;
    gap: 6px;
    margin-left: 6px;
  }

  .social a {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    color: var(--heading);
    transition: color 0.15s;
  }

  .social a:hover {
    color: var(--accent);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    margin-bottom: 56px;
    border-top: 1px solid var(--rule);
    border-left: 1px solid var(--rule);
  }

  .card {
    padding: 18px 20px;
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .card p {
    margin-top: 8px;
    font-size: 14px;
    line-height: 1.7;
  }

  @media (max-width: 720px) {
    .hero {
      grid-template-columns: 1fr;
      grid-template-areas: "photo" "text";
      gap: 28px;
      padding-top: 40px;
    }

    .photo {
      width: 140px;
      height: 175px;
      margin-top: 0;
    }
  }
</style>
