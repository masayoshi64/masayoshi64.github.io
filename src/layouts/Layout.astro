---
import "../styles/global.css";
import { LANGS, PAGES, UI, pagePath, profile, type Lang, type PageKey } from "../lib/site";

interface Props {
  lang: Lang;
  page: PageKey;
}

const { lang, page } = Astro.props;
const t = UI[lang];
const siteName = lang === "ja" ? `${profile.nameJa} (${profile.name})` : profile.name;
const title = t.title[page] ? `${t.title[page]} | ${profile.name}` : siteName;
const canonical = new URL(pagePath(page, lang), Astro.site);
const ogImage = new URL("/profile.jpg", Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={t.description} />
    <link rel="canonical" href={canonical} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={new URL(pagePath(page, l), Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(pagePath(page, "ja"), Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+JP:wght@400;500;700&display=swap"
    />
    <script is:inline>
      (() => {
        let theme;
        try {
          theme = localStorage.getItem("theme");
        } catch {}
        if (theme !== "light" && theme !== "dark") {
          theme = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <header class="header">
      <nav class="nav">
        <a class="logo" href={pagePath("home", lang)}>{profile.name}</a>
        <ul class="menu">
          {
            PAGES.map((p) => (
              <li>
                <a href={pagePath(p, lang)} class:list={{ active: p === page }} aria-current={p === page ? "page" : undefined}>
                  {t.nav[p]}
                </a>
              </li>
            ))
          }
        </ul>
        <div class="tools">
          <div class="lang">
            {
              LANGS.map((l) => (
                <a href={pagePath(page, l)} hreflang={l} lang={l} class:list={{ on: l === lang }} aria-current={l === lang ? "true" : undefined}>
                  {l.toUpperCase()}
                </a>
              ))
            }
          </div>
          <button class="theme-toggle" type="button" aria-label={t.toggleTheme} title={t.toggleTheme}>
            <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
            </svg>
            <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
            </svg>
          </button>
        </div>
      </nav>
      <ul class="mobile-menu">
        {
          PAGES.map((p) => (
            <li>
              <a href={pagePath(p, lang)} class:list={{ active: p === page }}>
                {t.nav[p]}
              </a>
            </li>
          ))
        }
      </ul>
    </header>
    <main>
      <slot />
    </main>
    <footer class="footer">© {new Date().getFullYear()} {profile.name}</footer>

    <script>
      document.querySelector(".theme-toggle")?.addEventListener("click", () => {
        const root = document.documentElement;
        const next = root.dataset.theme === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        try {
          localStorage.setItem("theme", next);
        } catch {}
      });
    </script>
  </body>
</html>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--header-bg);
    backdrop-filter: saturate(180%) blur(14px);
    -webkit-backdrop-filter: saturate(180%) blur(14px);
    border-bottom: 1px solid var(--border);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 24px;
    max-width: 1080px;
    height: var(--header-height);
    margin: 0 auto;
    padding: 0 24px;
  }

  .logo {
    margin-right: auto;
    font-size: 18px;
    font-weight: 800;
    letter-spacing: -0.02em;
    white-space: nowrap;
    color: var(--heading);
  }

  .menu {
    display: flex;
    gap: 22px;
  }

  .menu a {
    padding: 4px 0;
    font-size: 14.5px;
    font-weight: 500;
    color: var(--muted);
    border-bottom: 2px solid transparent;
    transition: color 0.15s;
  }

  .menu a:hover {
    color: var(--heading);
  }

  .menu a.active {
    color: var(--heading);
    border-color: var(--accent);
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .lang {
    display: flex;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
  }

  .lang a {
    padding: 4px 10px;
    font-size: 12px;
    font-weight: 700;
    color: var(--muted);
  }

  .lang a:hover {
    color: var(--accent);
  }

  .lang a.on {
    color: #fff;
    background: var(--accent);
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    color: var(--muted);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 50%;
    cursor: pointer;
  }

  .theme-toggle:hover {
    color: var(--accent);
  }

  :global([data-theme="dark"]) .icon-moon,
  :global([data-theme="light"]) .icon-sun {
    display: none;
  }

  .mobile-menu {
    display: none;
    gap: 4px;
    overflow-x: auto;
    padding: 0 16px 10px;
  }

  .mobile-menu a {
    display: block;
    padding: 4px 12px;
    font-size: 13.5px;
    font-weight: 500;
    white-space: nowrap;
    color: var(--muted);
    border-radius: 999px;
  }

  .mobile-menu a.active {
    color: var(--accent);
    background: var(--accent-soft);
  }

  .footer {
    padding: 28px 24px;
    font-size: 13px;
    text-align: center;
    color: var(--muted);
    border-top: 1px solid var(--border);
  }

  @media (max-width: 720px) {
    .menu {
      display: none;
    }

    .mobile-menu {
      display: flex;
    }
  }
</style>
